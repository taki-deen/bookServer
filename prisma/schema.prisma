generator client { 
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Author {
  id    Int     @id @default(autoincrement())
  name  String
  books Book[]  // One to Many relationship
}

model Book {
  id       Int     @id @default(autoincrement())
  name     String
  isbn     String
  aisle    String
  authorId Int
  author   Author  @relation(fields: [authorId], references: [id])
}
