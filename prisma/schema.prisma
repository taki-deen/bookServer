generator client { 
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Author {
  id    Int     @id @default(autoincrement())
  name  String
  books Book[]  @relation("AuthorToBook") // Many to Many relationship
}

model Book {
  id         Int        @id @default(autoincrement())
  name       String
  isbn       String
  aisle      String
  authors    Author[]   @relation("AuthorToBook") // Many to Many relationship
  bookshops  Bookshop[] @relation("BookToBookshop") // Many to Many relationship with Bookshop
}

model Bookshop {
  id      Int     @id @default(autoincrement())
  name    String
  address String
  books   Book[]  @relation("BookToBookshop") // Many to Many relationship with Book
}
